# ── SCCS Discipline Tracker — environment variables ──────────────────────
# Every variable is optional: the app runs with safe development fallbacks.
# Copy this file to `.env` and adjust for your deployment.

# SQLite database. The authoritative path lives in prisma/schema.prisma
# ("file:../db/sccs.db" → <project root>/db/sccs.db); DATABASE_URL is kept
# here only for tooling that expects it and is ignored by Prisma while the
# schema uses a literal url.
DATABASE_URL="file:../db/sccs.db"

# Initial admin account created by `bun run db:seed` — only used if no admin
# exists yet. CHANGE THE PASSWORD for anything beyond a local demo.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123
INITIAL_ADMIN_FIRST_NAME=System
INITIAL_ADMIN_LAST_NAME=Administrator

# JWT signing secret for login sessions. The code falls back to a development
# secret — replace it with a long random string for any real deployment.
JWT_SECRET="change-me-to-a-long-random-string"

# Version handshake between the SPA and the API (GET /api/version). Keep
# APP_VERSION and NEXT_PUBLIC_APP_VERSION in sync to avoid the "new version
# available" banner.
APP_VERSION=2.1.0
MIN_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_VERSION=2.1.0

# Database Connection
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/sccs_discipline

# For local development with Docker PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sccs_discipline

# For Supabase (production):
# DATABASE_URL=postgresql://postgres.<project_ref>:your_password@aws-<region>.pooler.supabase.com:6543/postgres

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Optional: Firebase (for future features)
# FIREBASE_PROJECT_ID=sccs-disciplinary-tracker
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
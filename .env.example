# Database Connection
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/sccs_discipline

# For local development with Docker PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sccs_discipline

# REQUIRED. The server refuses to start without this — there is deliberately no
# fallback, because a default committed to the repository would let anyone forge
# a token for any account. Generate one with: openssl rand -hex 32
JWT_SECRET=

# First administrator account, created once on an empty database.
# After that account exists these are ignored, so changing the password here does
# nothing — use the app's password reset instead. Safe to unset after first boot.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=
INITIAL_ADMIN_LAST_NAME=

# Frontend API base URL (set at client build time)
VITE_API_URL=http://localhost:3001/api

# Browser origins allowed to call this API, comma-separated.
# The web app is served from the same origin and needs no entry here; this is
# for the Capacitor Android build, whose webview has its own origin.
# Leave empty to allow same-origin and non-browser clients only.
ALLOWED_ORIGINS=

# SMTP — optional. Without it, parent notifications are refused with a clear
# message rather than falsely reported as sent, and password reset tokens go to
# the server log instead of the user's inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
